# ── Server ────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
STORE_MANAGEMENT_URL=http://localhost:5001

# ── Database (Cloud-native PostgreSQL — 1 write + 2 read replicas) ────────────
# Primary (write)
DATABASE_URL=postgresql://USER:PASSWORD@primary.host:5432/business_db?sslmode=require
# Used by Prisma Migrate / db push (bypasses pooler)
DIRECT_URL=postgresql://USER:PASSWORD@primary.host:5432/business_db?sslmode=require
# Read replica 1
DATABASE_URL_REPLICA_1=postgresql://USER:PASSWORD@replica-1.host:5432/business_db?sslmode=require
# Read replica 2
DATABASE_URL_REPLICA_2=postgresql://USER:PASSWORD@replica-2.host:5432/business_db?sslmode=require

# ── Auth (shared JWT secret with store-management) ────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Courier: Steadfast ────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Courier: Pathao ───────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
