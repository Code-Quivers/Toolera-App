# ── Server ────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BUSINESS_SERVICE_URL=http://localhost:5002

# ── Database (Cloud-native PostgreSQL — 1 write + 2 read replicas) ────────────
# Primary (write)
DATABASE_URL=postgresql://USER:PASSWORD@primary.host:5432/store_management_db?sslmode=require
# Used by Prisma Migrate / db push (bypasses pooler)
DIRECT_URL=postgresql://USER:PASSWORD@primary.host:5432/store_management_db?sslmode=require
# Read replica 1
DATABASE_URL_REPLICA_1=postgresql://USER:PASSWORD@replica-1.host:5432/store_management_db?sslmode=require
# Read replica 2
DATABASE_URL_REPLICA_2=postgresql://USER:PASSWORD@replica-2.host:5432/store_management_db?sslmode=require

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Internal Service ──────────────────────────────────
INTERNAL_SERVICE_KEY=your-secret-internal-key-here

# ── Courier: Steadfast ────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Courier: Pathao ───────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# ── Message Brokers ────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=store-management-service

# ── Object Storage (MinIO for dev, AWS S3 for prod — same code) ──────────────
# MinIO local dev:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=toolera-media
STORAGE_REGION=ap-southeast-1
STORAGE_PUBLIC_URL=http://localhost:9000/toolera-media
STORAGE_FORCE_PATH_STYLE=true
# AWS S3 prod (just change these, remove STORAGE_ENDPOINT, set FORCE_PATH_STYLE=false):
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
# STORAGE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STORAGE_BUCKET=toolera-media-prod
# STORAGE_REGION=ap-southeast-1
# STORAGE_PUBLIC_URL=https://toolera-media-prod.s3.ap-southeast-1.amazonaws.com
# STORAGE_FORCE_PATH_STYLE=false

# ── Redis (shared session store — same URL as api-gateway) ────
REDIS_URL=redis://localhost:6379
# Token TTL in seconds (default 86400 = 24 h)
REDIS_EXPIRES_IN=86400
