# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BUSINESS_SERVICE_URL=http://localhost:5002

# ── Database ──────────────────────────────────────────────────────────────────
# Primary (write) — used by drizzle-kit and the app
DATABASE_URL=postgresql://postgres:password@localhost:5433/toolera_store_management_db
# Optional read replicas (leave blank for single-node dev)
DATABASE_URL_REPLICA_1=
DATABASE_URL_REPLICA_2=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET used by api-gateway and business service
JWT_SECRET=change-me-min-32-chars-shared-secret

# ── SMS (Green Web BD or similar) ─────────────────────────────────────────────
SMS_API_KEY=
SMS_SENDER_ID=

# ── Object Storage ────────────────────────────────────────────────────────────
# MinIO (local dev) — run docker compose -f docker-compose.dev.yml up -d
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=toolera-media
STORAGE_REGION=ap-southeast-1
STORAGE_PUBLIC_URL=http://localhost:9000/toolera-media
STORAGE_FORCE_PATH_STYLE=true
# AWS S3 (prod) — remove STORAGE_ENDPOINT and set FORCE_PATH_STYLE=false:
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
# STORAGE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STORAGE_BUCKET=toolera-media-prod
# STORAGE_REGION=ap-southeast-1
# STORAGE_PUBLIC_URL=https://toolera-media-prod.s3.ap-southeast-1.amazonaws.com
# STORAGE_FORCE_PATH_STYLE=false

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=store-management-service

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_EXPIRES_IN=86400
