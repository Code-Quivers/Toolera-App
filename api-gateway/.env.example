# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Downstream Services ───────────────────────────────
STORE_MANAGEMENT_URL=http://localhost:5001
BUSINESS_SERVICE_URL=http://localhost:5002

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=toolera_shared_jwt_secret_dev_2026_min32chars_xK9!

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,https://yourdomain.com

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_MAX=200

# ── Redis (session token store — not a response cache) ─
REDIS_URL=redis://localhost:6379
# Token TTL in seconds (default 86400 = 24 h)
REDIS_EXPIRES_IN=86400
