# ── Server ────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BUSINESS_SERVICE_URL=http://localhost:5002

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/store_management_db
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/store_management_db

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Internal Service ──────────────────────────────────
INTERNAL_SERVICE_KEY=your-secret-internal-key-here

# ── Courier: Steadfast ────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Courier: Pathao ───────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
