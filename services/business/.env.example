# ── Server ────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
STORE_MANAGEMENT_URL=http://localhost:5001

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/business_db
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/business_db

# ── Auth (shared JWT secret with store-management) ────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ── Courier: Steadfast ────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Courier: Pathao ───────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
